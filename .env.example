# ─────────────────────────────────────────────────────────────────────────────
# LipSight — environment configuration
# Copy to .env and adjust. Every value here has a safe default in code.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=development
APP_NAME=LipSight
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ── Database ────────────────────────────────────────────────────────────────
# Production: PostgreSQL. Leave unset locally to use a SQLite file (no server).
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/lipsight
DATABASE_URL=

# ── Storage ─────────────────────────────────────────────────────────────────
# local | s3
STORAGE_BACKEND=local
STORAGE_PATH=./storage
# S3 (only used when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Upload limits / validation ──────────────────────────────────────────────
MAX_VIDEO_DURATION_SECONDS=300
MAX_UPLOAD_SIZE_MB=2048
ALLOWED_VIDEO_EXTENSIONS=mp4,mov,webm,m4v
ALLOWED_VIDEO_MIME=video/mp4,video/quicktime,video/webm,video/x-m4v

# ── Sampling ────────────────────────────────────────────────────────────────
COARSE_FPS=8
ANALYSIS_FPS=25

# ── Device ──────────────────────────────────────────────────────────────────
# auto | cuda | mps | cpu
DEVICE=auto

# ── Quality gates (§65) ─────────────────────────────────────────────────────
MIN_FACE_WIDTH=80
MIN_FACE_QUALITY=60
MIN_MOUTH_VISIBILITY=0.60
MIN_TRACKING_STABILITY=0.60

# ── Readiness score weights (§15) — must sum to 1.0 ─────────────────────────
READINESS_W_FACE_QUALITY=0.25
READINESS_W_MOUTH_VISIBILITY=0.20
READINESS_W_FACE_RESOLUTION=0.20
READINESS_W_TRACKING_STABILITY=0.15
READINESS_W_POSE_QUALITY=0.10
READINESS_W_SHARPNESS=0.10

# ── Models directory (weights fetched by scripts/download_models.py) ─────────
MODELS_DIR=./models

# ── Model selection ─────────────────────────────────────────────────────────
PERSON_DETECTOR=yolo
FACE_DETECTOR=mediapipe
TRACKER=bytetrack
# lipnet = real English visual speech recognition (GRID). Default + runnable.
LIP_READING_MODEL=lipnet
TTS_PROVIDER=local
YOLO_IMG_SIZE=1280
# Leave blank to auto-resolve from MODELS_DIR (models/yolov8n.pt, models/lipnet_overlap.pt, ...).
YOLO_PERSON_WEIGHTS=
LIP_READING_WEIGHTS=
DLIB_LANDMARKS=

# ── Safety ──────────────────────────────────────────────────────────────────
# Mock ML adapters are for tests ONLY. Never enable in production.
ALLOW_MOCK_INFERENCE=0

# ── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
