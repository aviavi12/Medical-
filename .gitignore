# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log

# Env
.env
.env.local

# Storage / runtime artifacts (never commit uploaded videos or derived data)
storage/
!storage/.gitkeep
*.sqlite
*.sqlite3
*.db

# Node / Next.js
node_modules/
apps/web/.next/
apps/web/out/
apps/web/next-env.d.ts
.turbo/

# ML weights / checkpoints (never commit large binaries) — fetched by scripts/download_models.py
training/checkpoints/
models/
*.pt
*.pth
*.onnx
*.task
*.tflite
*.dat

# Downloaded test fixtures (redistributable but reconstructed by download_models.py)
tests/fixtures/visual_speech/grid/*.mpg

# CLI/demo outputs
results/

# Generated evaluation report JSON (the .md is committed)
docs/open-vocabulary-evaluation.json

# User-provided natural-English evaluation videos (see evaluation/open_vocabulary/README.md)
evaluation/open_vocabulary/*/*.mp4
evaluation/open_vocabulary/*/*.mov
evaluation/open_vocabulary/*/*.webm
evaluation/open_vocabulary/*/*.mkv

# OS / editor
.DS_Store
.idea/
.vscode/

# Test / build outputs
out/
dist/
coverage/
htmlcov/
apps/web/*.tsbuildinfo
